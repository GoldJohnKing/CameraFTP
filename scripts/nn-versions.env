# NN demosaic dependency versions, sourced by build.sh, build-android.sh and
# fetch-nn-deps.sh so the vendor-cache dir names and packaging paths stay in
# sync with what fetch-nn-deps.sh actually downloads.
#
# NN_DEMOSAIC_VERSION: onnxruntime release (also used for the Android
#   onnxruntime-android-qnn AAR and the Windows/Linux ORT archives).
#   Verify at onnxruntime.ai.
# QNN_RUNTIME_VERSION: com.qualcomm.qti:qnn-runtime Maven AAR version
#   (must match the ORT qnn AAR's POM dependency).
NN_DEMOSAIC_VERSION=1.24.1
QNN_RUNTIME_VERSION=2.42.0
