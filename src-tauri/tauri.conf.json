{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "com.gjk.cameraftpcompanion",
  "productName": "图传伴侣",
  "version": "1.9.2",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "./scripts/build-frontend.sh",
    "frontendDist": "../dist",
    "devUrl": null,
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "图传伴侣",
        "width": 400,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost http://image-preview.localhost image-preview: data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPCACHE/**", "$APPDATA/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": []
  }
}